# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.env

# OS
.DS_Store

# IDE / local config
.claude/

# Large files (optional, if you want to exclude PDFs)
*.pdf

# Large data directories (too large for GitHub)
v_1/data/raw/
v_1/data/prepared/
v_1/data/processed/archibab/
v_1/data/processed/ebl/
v_1/data/processed/oracc/
v_1/data/external/
# Keep v_1/data/processed/unified/ (small enough for GitHub)

# Personal planning & sensitive files (salary, career, emails, personal strategy)
yarin/

# Model checkpoints (large, cluster-only)
v_1/models/

# Large activation files — cluster-only; only commit the derived JSON coords
*.npz
v_1/src/linear_probing/results/seal_round4/activations/
v_1/src/linear_probing/results/orcc_round1/activations/

# Generated standalone HTML (built from seal_eda.html + seal_viz_data.json)
v_1/src/viz/seal_eda_standalone.html

# Cluster job logs — never commit (huge)
*.out
**/logs/

# Portable panel viewer — 31MB base64 artifact, regenerate with make_panel_gallery.py
v_1/src/stress_tests/e6_clusters/embedding_panels/standalone.html

# chronorank autopsy per-draw intermediates: mc_balanced writes one JSON per Monte-Carlo
# draw (…__drawNNN.json, ~200 per arm) and then reduces them into __summary.json, which
# IS tracked. The per-draw files are scratch, but they were leaving the cluster checkout
# permanently dirty and blocking `git pull` before sbatch jobs could start.
v_1/src/chronorank/autopsy/results/probes/*__draw[0-9][0-9][0-9].json

# chrono cluster jobs need their slurm --output dir to EXIST in a fresh
# clone: Slurm opens the file before the script (and its mkdir) runs.
!chrono/sbatch/logs/
!chrono/sbatch/logs/.gitkeep

# chrono cluster jobs push their slurm logs here so a FAILED run can be
# read from the repo instead of a browser terminal; **/logs/ above
# would otherwise swallow them.
!chrono/reports/logs/
!chrono/reports/logs/**

# runner outputs must reach the repo; *.out above would swallow them
!chrono/agent/outbox/
!chrono/agent/outbox/**
