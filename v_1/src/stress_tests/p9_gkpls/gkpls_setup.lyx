\begin_layout Title
Geodesic Kernel Probes for Chronology: Setup and Estimators
\end_layout

\begin_layout Author
Yarin Benizri
\end_layout

\begin_layout Section
Setup
\end_layout

\begin_layout Standard
Let
\begin_inset Formula $x_{1},\dots,x_{n}\in\mathbb{R}^{d}$
\end_inset

 be the mean-pooled hidden states of the
\begin_inset Formula $n=1202$
\end_inset

 fragments (one layer at a time), with rows
\begin_inset Formula $\ell_{2}$
\end_inset

-normalized, and let
\begin_inset Formula $y_{i}\in\mathbb{R}$
\end_inset

 denote the labels (year BCE).
 All estimators below access the data only through a Gram matrix
\begin_inset Formula $K\in\mathbb{R}^{n\times n}$
\end_inset

; they differ in which
\begin_inset Formula $K$
\end_inset

 they build and which regression operator they apply to it.
\end_layout

\begin_layout Section
Two kernels
\end_layout

\begin_layout Subsection
Geodesic (Isomap) kernel
\end_layout

\begin_layout Standard
Build the
\begin_inset Formula $k$
\end_inset

-nearest-neighbor graph
\begin_inset Formula $G$
\end_inset

 (
\begin_inset Formula $k=10$
\end_inset

, Euclidean edge weights
\begin_inset Formula $w_{ij}=\left\Vert x_{i}-x_{j}\right\Vert _{2}$
\end_inset

, symmetrized).
 Let
\begin_inset Formula $D_{G}(i,j)$
\end_inset

 be the shortest-path distance in
\begin_inset Formula $G$
\end_inset

.
 Double-center the squared distances:
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
K_{G}=-\tfrac{1}{2}\,H\,D_{G}^{\circ2}\,H,\qquad H=I-\tfrac{1}{n}\mathbf{1}\mathbf{1}^{\top},
\]
\end_inset

where
\begin_inset Formula $D_{G}^{\circ2}$
\end_inset

 is the entrywise square.
 We then project
\begin_inset Formula $K_{G}$
\end_inset

 onto the positive-semidefinite cone by clipping negative eigenvalues,
 since geodesic distance matrices are in general not exactly Euclidean-embeddable.

\begin_inset Formula $K_{G}$
\end_inset

 is precisely the Gram matrix whose kernel PCA reproduces Isomap.
\end_layout

\begin_layout Subsection
RBF kernel (curvature-blind control on the same points)
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
K_{\mathrm{RBF}}(i,j)=\exp\!\left(-\left\Vert x_{i}-x_{j}\right\Vert _{2}^{2}/2\sigma^{2}\right),\qquad\sigma=\operatorname{median}_{i<j}\left\Vert x_{i}-x_{j}\right\Vert _{2}.
\]
\end_inset

The pair
\begin_inset Formula $\{K_{G},K_{\mathrm{RBF}}\}$
\end_inset

 differs only in the metric (geodesic along the data vs.
 ambient Euclidean), so their comparison isolates the contribution of manifold
 curvature.
\end_layout

\begin_layout Section
Three regression operators
\end_layout

\begin_layout Subsection
Kernel PLS (Rosipal–Trejo)
\end_layout

\begin_layout Standard
On
\begin_inset Formula $K\in\{K_{G},K_{\mathrm{RBF}}\}$
\end_inset

: iteratively extract score vectors
\begin_inset Formula $t_{m}\propto Ku_{m}$
\end_inset

 maximizing covariance with
\begin_inset Formula $y$
\end_inset

, deflate
\begin_inset Formula $K$
\end_inset

 and
\begin_inset Formula $y$
\end_inset

, and regress
\begin_inset Formula $y$
\end_inset

 on
\begin_inset Formula $(t_{1},\dots,t_{a})$
\end_inset

; the number of components
\begin_inset Formula $a\in\{1,2,3,5\}$
\end_inset

 is chosen by validation.
 We write
\emph on
G-KPLS
\emph default
 for KPLS applied to
\begin_inset Formula $K_{G}$
\end_inset

 and
\emph on
RBF-KPLS
\emph default
 for KPLS applied to
\begin_inset Formula $K_{\mathrm{RBF}}$
\end_inset

.
\end_layout

\begin_layout Subsection
Kernel ridge regression on
\begin_inset Formula $K_{G}$
\end_inset

\end_layout

\begin_layout Standard
\begin_inset Formula
\[
\hat{f}(\cdot)=k(\cdot)^{\top}\left(K_{G}+\lambda I\right)^{-1}y,\qquad\lambda\in\{10^{-3},10^{-2},10^{-1}\},
\]
\end_inset

with the inverse taken on the truncated spectrum (eigenvalues
\begin_inset Formula $\lambda_{j}>10^{-8}\lambda_{\max}$
\end_inset

): the clipped kernel is rank-deficient, and the naive solve amplifies its
 null space.
\end_layout

